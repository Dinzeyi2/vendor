{
  "name": "causal.estimate_effect",
  "aliases": [
    "dowhy.estimate_effect"
  ],
  "summary": "Estimate the average causal effect of a treatment on an outcome from observational data, adjusting for confounders.",
  "when_to_use": "Use when you have observational rows and want to know how much one variable (a treatment, such as a discount or a feature launch) changes an outcome, controlling for other factors. Not for predictions: use tabular.train_and_predict.",
  "intents": [
    "estimate the causal effect of the treatment on the outcome",
    "what is the effect of the discount on spend",
    "causal inference from observational data",
    "does the treatment cause the outcome",
    "average treatment effect adjusting for confounders",
    "measure the impact of a change controlling for other factors",
    "how much does x increase y causally"
  ],
  "clarify": "Which columns are the treatment and the outcome, and what is the data? Send data like {\"data\": {\"t\": [...], \"y\": [...]}, \"treatment\": \"t\", \"outcome\": \"y\"}.",
  "runtime": {
    "kind": "python",
    "worker": "dowhy",
    "module": "app.ops.dowhy_ops",
    "internal": "dowhy.estimate_effect"
  },
  "timeouts": {
    "default": 60,
    "max": 300
  },
  "input_schema": {
    "type": "object",
    "properties": {
      "data": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
          "type": "array"
        },
        "description": "Columns: {\"name\": [numbers]}, all the same length (10-200,000 rows)",
        "x-aliases": [
          "table",
          "columns",
          "dataset",
          "rows"
        ]
      },
      "treatment": {
        "type": "string",
        "description": "Treatment column",
        "x-aliases": [
          "cause",
          "intervention"
        ]
      },
      "outcome": {
        "type": "string",
        "description": "Outcome column",
        "x-aliases": [
          "effect_on",
          "result",
          "target"
        ]
      },
      "common_causes": {
        "type": [
          "array",
          "null"
        ],
        "items": {
          "type": "string"
        },
        "description": "Confounder columns",
        "x-aliases": [
          "confounders",
          "controls",
          "covariates"
        ]
      },
      "instruments": {
        "type": [
          "array",
          "null"
        ],
        "items": {
          "type": "string"
        },
        "description": "Instrumental variable columns"
      },
      "method": {
        "enum": [
          "backdoor.linear_regression",
          "backdoor.propensity_score_matching",
          "backdoor.propensity_score_stratification",
          "backdoor.propensity_score_weighting",
          "iv.instrumental_variable"
        ],
        "default": "backdoor.linear_regression"
      }
    },
    "required": [
      "data",
      "treatment",
      "outcome"
    ]
  },
