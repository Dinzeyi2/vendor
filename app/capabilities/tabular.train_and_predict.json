    "copyright": "Copyright (c) 2019 by Contributors (XGBoost)",
    "source": "https://github.com/dmlc/xgboost",
    "license_file": "licenses/XGBoost-Apache-2.0.txt",
    "dependency": {
      "manager": "pip",
      "name": "xgboost",
      "version": "3.4.1"
    }
  }
}
