{
  "name": "image.detect_edges",
  "aliases": [
    "kornia.canny"
  ],
  "summary": "Detect edges in an image (Canny) and return the edge mask as a PNG plus edge statistics.",
  "intents": [
    "detect the edges in this image",
    "edge detection on a photo",
    "find outlines in a picture",
    "canny edges of an image",
    "extract contours and edges from an image",
    "highlight the borders of shapes in an image"
  ],
  "clarify": "Which image should I process? Send it as data: {\"image_base64\": \"<base64 PNG or JPEG>\"}.",
  "runtime": {
    "kind": "python",
    "worker": "kornia",
    "module": "app.ops.kornia_ops",
    "internal": "kornia.canny"
  },
  "timeouts": {
    "default": 60,
    "max": 120
  },
  "input_schema": {
    "type": "object",
    "properties": {
      "image_base64": {
        "type": "string",
        "minLength": 1,
        "x-aliases": [
          "image",
          "png",
          "jpeg",
          "jpg",
          "photo",
          "picture",
          "file",
          "base64"
        ],
        "description": "The image (PNG, JPEG, ...) as base64, optionally as a data: URL. Up to 16 megapixels"
      },
      "low_threshold": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "description": "Lower edge threshold",
        "default": 0.1
      },
      "high_threshold": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "description": "Upper edge threshold",
        "default": 0.2
      },
      "kernel_size": {
        "type": "integer",
        "minimum": 3,
        "maximum": 31,
        "description": "Odd blur kernel size",
        "default": 5
      },
      "sigma": {
        "type": "number",
        "minimum": 0.1,
        "maximum": 20,
        "description": "Blur strength",
        "default": 1.0
      },
      "return_image": {
        "default": true,
        "description": "false: statistics only"
      }
    },
    "required": [
      "image_base64"
    ]
  },
  "data_bindings": [
    {
      "when": {
        "type": "string",
        "minLength": 1
      },
      "inputs": {
        "image_base64": ""
      }
    }
  ],
  "example": {
    "request": "Detect the edges in this image",
    "data": {
      "image_base64": "iVBORw0KGgoAAAANSUhEUgAAADAAAAAwCAAAAAByaaZbAAAAJ0lEQVR42mNgGAWjgDqAEZnznwhFTKTaMKphVMOohlENo2AUDAwAALq1ATA8CXn2AAAAAElFTkSuQmCC"
    },
    "inputs": {
      "image_base64": "iVBORw0KGgoAAAANSUhEUgAAADAAAAAwCAAAAAByaaZbAAAAJ0lEQVR42mNgGAWjgDqAEZnznwhFTKTaMKphVMOohlENo2AUDAwAALq1ATA8CXn2AAAAAElFTkSuQmCC"
    },
    "output": {
      "width": 48,
      "height": 48,
      "edge_pixels": 92,
      "edge_fraction": 0.0399,
      "edges_png_base64": "iVBORw0KGgoAAAANSUhEUgAAADAAAAAwCAAAAABy..."
    }
  },
  "built_on": {
    "project": "Kornia",
    "license": "Apache-2.0",
    "copyright": "Copyright the Kornia authors",
    "source": "https://github.com/kornia/kornia",
    "license_file": "licenses/Kornia-Apache-2.0.txt",
    "dependency": {
      "manager": "pip",
      "name": "kornia",
      "version": "0.9.2"
    }
  }
}
