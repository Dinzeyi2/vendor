{
  "name": "scheduling.school_timetable",
  "aliases": [
    "timefold.school_timetabling"
  ],
  "summary": "Assign lessons to timeslots and rooms with no room, teacher or student-group double-booking.",
  "when_to_use": "Use when you need to place lessons (or any meetings with a teacher and a group) into timeslots and rooms so that no room, teacher or group is booked twice.",
  "intents": [
    "make a school timetable",
    "schedule these lessons into rooms and timeslots",
    "build a class schedule without conflicts",
    "assign teachers lessons to time slots",
    "timetabling for classes",
    "plan the weekly lesson schedule"
  ],
  "clarify": "What are the timeslots, rooms and lessons? Send data like {\"timeslots\": [...], \"rooms\": [...], \"lessons\": [...]}.",
  "runtime": {
    "kind": "python",
    "worker": "timefold",
    "module": "app.ops.timefold_ops",
    "internal": "timefold.school_timetabling",
    "env_profile": "java"
  },
  "timeouts": {
    "default": 60,
    "max": 180
  },
  "input_schema": {
    "type": "object",
    "properties": {
      "timeslots": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "id",
            "day_of_week",
            "start_time",
            "end_time"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "day_of_week": {
              "type": "string"
            },
            "start_time": {
              "type": "string"
            },
            "end_time": {
              "type": "string"
            }
          }
        },
        "maxItems": 500,
        "x-aliases": [
          "slots",
          "periods"
        ]
      },
      "rooms": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "id",
            "name"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "maxItems": 200,
        "x-aliases": [
          "classrooms"
        ]
      },
      "lessons": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "id",
            "subject",
            "teacher",
            "student_group"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "subject": {
              "type": "string"
            },
            "teacher": {
              "type": "string"
            },
            "student_group": {
              "type": "string"
            }
          }
        },
        "maxItems": 2000,
        "x-aliases": [
          "classes",
          "courses"
        ]
      },
      "time_limit_seconds": {
        "type": "number",
        "minimum": 1,
        "maximum": 120,
        "description": "How long to search",
        "default": 5
      }
    },
    "required": [
      "timeslots",
      "rooms",
      "lessons"
    ]
  },
