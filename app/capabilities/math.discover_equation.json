{
  "name": "math.discover_equation",
  "aliases": [
    "pysr.symbolic_regression"
  ],
  "summary": "Discover a readable mathematical formula that fits your data (symbolic regression).",
  "when_to_use": "Use when you have numeric inputs and outputs and want a human-readable formula that explains them, rather than a black-box model. Best for small, clean datasets (tens to hundreds of rows).",
  "intents": [
    "find the equation that fits this data",
    "discover a formula for y in terms of x",
    "symbolic regression",
    "what mathematical expression explains these points",
    "fit a readable formula to my data",
    "derive the law behind these measurements"
  ],
  "clarify": "What are the input rows X and the values y to explain? Send data like {\"X\": [[1], [2], [3], [4], [5]], \"y\": [3, 6, 11, 18, 27]}.",
  "runtime": {
    "kind": "python",
    "worker": "pysr",
    "module": "app.ops.pysr_ops",
    "internal": "pysr.symbolic_regression",
    "env": {
      "PYTHON_JULIACALL_HANDLE_SIGNALS": "yes"
    }
  },
  "timeouts": {
    "default": 300,
    "max": 900
  },
  "input_schema": {
    "type": "object",
    "properties": {
      "X": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        },
        "description": "Input rows; columns are x0, x1, ... (5-10,000 rows, up to 20 columns)",
        "maxItems": 10000,
        "x-aliases": [
          "x",
          "inputs",
          "features",
          "rows"
        ]
      },
      "y": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "number"
        },
        "description": "Value to explain, one per row",
        "x-aliases": [
          "target",
          "values",
          "outputs"
        ]
      },
      "binary_operators": {
        "type": "array",
        "items": {
          "enum": [
            "+",
            "-",
            "*",
            "/",
            "^",
            "max",
            "min"
          ]
        },
        "default": [
          "+",
          "-",
          "*",
          "/"
        ]
      },
      "unary_operators": {
        "type": "array",
        "items": {
          "enum": [
            "sin",
            "cos",
            "exp",
            "log",
            "sqrt",
            "abs",
            "square",
            "cube",
            "neg",
            "inv",
            "tanh"
          ]
        },
        "default": []
      },
      "niterations": {
        "type": "integer",
        "minimum": 1,
        "maximum": 500,
        "description": "Search iterations",
        "default": 20
      },
      "populations": {
        "type": "integer",
        "minimum": 1,
        "maximum": 64,
        "description": "Populations",
        "default": 8
      },
      "maxsize": {
        "type": "integer",
        "minimum": 5,
        "maximum": 50,
        "description": "Maximum equation size",
        "default": 20
      },
      "random_state": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647,
        "description": "Seed",
        "default": 0
      }
    },
    "required": [
      "X",
      "y"
    ]
  },
  "example": {
    "request": "Find the equation that fits this data",
    "data": {
      "X": [
        [
          -2
        ],
        [
          -1.5
        ],
        [
          -1
        ],
        [
          -0.5
        ],
        [
          0
        ],
        [
          0.5
        ],
        [
          1
        ],
        [
          1.5
        ],
        [
          2
        ],
        [
          2.5
        ]
      ],
      "y": [
        6,
        4.25,
        3,
        2.25,
        2,
        2.25,
        3,
        4.25,
        6,
        8.25
      ],
      "niterations": 15,
      "random_state": 0
    },
    "inputs": {
      "X": [
        [
          -2
        ],
        [
          -1.5
        ],
        [
          -1
        ],
        [
          -0.5
        ],
        [
          0
        ],
        [
          0.5
        ],
        [
          1
        ],
        [
          1.5
        ],
        [
          2
        ],
        [
          2.5
        ]
      ],
      "y": [
        6,
        4.25,
        3,
        2.25,
        2,
        2.25,
        3,
        4.25,
        6,
        8.25
      ],
      "niterations": 15,
      "random_state": 0
    },
    "output": {
      "best": {
        "equation": "x0*x0 + 2.0",
        "julia": "(x0 * x0) + 2.0",
        "loss": 0.0,
        "complexity": 5
      },
      "pareto_front": [
        {
          "equation": "4.12499950000000",
          "loss": 3.815625,
          "complexity": 1
        },
        {
          "equation": "x0 - 1*(-3.874997)",
          "loss": 3.8156247,
          "complexity": 3
        },
        {
          "equation": "x0*x0 + 2.0",
          "loss": 0.0,
          "complexity": 5
        }
      ],
      "feature_names": [
        "x0"
      ]
    }
  },
  "built_on": {
    "project": "PySR",
    "license": "Apache-2.0",
    "copyright": "Copyright 2020 Miles Cranmer",
    "source": "https://github.com/MilesCranmer/PySR",
    "license_file": "licenses/PySR-Apache-2.0.txt",
    "dependency": {
      "manager": "pip",
      "name": "pysr",
      "version": "2.7.2"
    }
  }
}
