{
  "name": "image.extract_text",
  "aliases": [
    "paddleocr.ocr"
  ],
  "summary": "Read printed text in an image (OCR) and return each line with its confidence and bounding box.",
  "when_to_use": "Use when an image (a screenshot, scanned page, receipt or photo of a sign) contains printed text you want as plain text, with each line's position and confidence.",
  "intents": [
    "read the text in this image",
    "extract text from an image",
    "ocr this picture",
    "what does this image say",
    "transcribe the words in a screenshot",
    "scan a receipt and get the text",
    "recognize printed text in a photo"
  ],
  "clarify": "Which image should I read? Send it as data: {\"image_base64\": \"<base64 PNG or JPEG>\"}.",
  "runtime": {
    "kind": "python",
    "worker": "paddleocr",
    "module": "app.ops.paddleocr_ops",
    "internal": "paddleocr.ocr",
    "env": {
      "PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK": "True"
    }
  },
  "timeouts": {
    "default": 120,
    "max": 300
  },
  "input_schema": {
    "type": "object",
    "properties": {
      "image_base64": {
        "type": "string",
        "minLength": 1,
        "x-aliases": [
          "image",
          "png",
          "jpeg",
          "jpg",
          "photo",
          "picture",
          "file",
          "base64"
        ],
        "description": "The image (PNG, JPEG, ...) as base64, optionally as a data: URL. Up to 16 megapixels"
      },
      "lang": {
        "enum": [
          "en",
          "ch",
          "fr",
          "german",
          "es",
          "it",
          "pt",
          "ru",
          "japan",
          "korean"
        ],
        "default": "en",
        "x-aliases": [
          "language"
        ]
      }
    },
    "required": [
      "image_base64"
    ]
  },
  "data_bindings": [
    {
      "when": {
        "type": "string",
        "minLength": 1
      },
      "inputs": {
        "image_base64": ""
      }
    }
  ],
  "example": {
    "request": "Read the text in this image",
    "data": {
      "image_base64": ""
    },
    "inputs": {
      "image_base64": ""
    },
    "output": {
      "lines": [
        {
          "text": "Hello Cognex",
          "confidence": 0.999910295009613,
          "box": [
            5,
            7,
            167,
            39
          ]
        }
      ],
      "text": "Hello Cognex",
      "lang": "en"
    }
  },
  "built_on": {
    "project": "PaddleOCR and its pretrained OCR models",
    "license": "Apache-2.0",
    "copyright": "Copyright (c) 2016 PaddlePaddle Authors. All Rights Reserved.",
    "source": "https://github.com/PaddlePaddle/PaddleOCR",
    "license_file": "licenses/PaddleOCR-Apache-2.0.txt",
    "dependency": {
      "manager": "pip",
      "name": "paddleocr",
      "version": "3.7.0"
    }
  }
}
